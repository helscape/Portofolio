# Database for blog comments.
# Bun loads .env automatically; copy this file to .env and fill it in.
#
# Comments stay off unless DB_NAME is set and the database is reachable, so
# leaving these blank keeps the site a plain static server.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Required to moderate comments (hide/unhide/delete) and to see hidden ones.
# There is no login: whoever holds this can moderate. Generate one with
#   printf 'ADMIN_TOKEN=%s\n' "$(openssl rand -hex 32)" >> .env
ADMIN_TOKEN=change-me-to-a-long-random-string

# Set to 1 when a reverse proxy sits in front of the server; the proxy then
# supplies the client IP in X-Forwarded-For for rate limiting.
TRUST_PROXY=0
